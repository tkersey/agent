    "scenario": "test/agent4/inquiry_cases_runtime.mjs RUNTIME FIXTURES NATIVE INSPECTOR --comparison-only",
    "recording": "Uninstalled instrumentation captures the canonical input and output bytes of every invocation; all original scenario assertions, native/Wasmtime comparisons and cleanup remain.",
    "comparisonSource": "import assert from 'node:assert/strict';\nimport {readFileSync,readdirSync,writeFileSync} from 'node:fs';\nimport {pathToFileURL} from 'node:url';\nconst [agentRoot,runtimePath,controlRoot,candidateRoot,output]=process.argv.slice(2);\nconst {verifyRuntime}=await import(pathToFileURL(agentRoot+'/tools/agent4/dependencies.mjs'));\nconst runtime=verifyRuntime(runtimePath),world=await import(pathToFileURL(runtime.entrypoint));\nconst hex=v=>Buffer.from(v).toString('hex');\nasync function observation(path){const out=world.decodeOutcome(readFileSync(path));if(out.kind==='requested'){const r=await world.decodeRequest(out.request);return {kind:out.kind,identity:r.semanticIdentity,payloadSchema:hex(r.payloadSchema),resumeSchema:hex(r.resumeSchema),payload:hex(r.payload)};}const copy={...out};delete copy.state;return copy;}\nconst names=readdirSync(controlRoot).sort();assert.deepEqual(readdirSync(candidateRoot).sort(),names);const rows=[];\nfor(const name of names){const a=JSON.parse(readFileSync(`${controlRoot}/${name}/trace.json`)),b=JSON.parse(readFileSync(`${candidateRoot}/${name}/trace.json`));assert.equal(a.recorded.length,b.recorded.length,name+' boundary count');for(let i=0;i<a.recorded.length;i++){const index=String(i).padStart(4,'0');assert.deepEqual(await observation(`${controlRoot}/${name}/${index}.pko3`),await observation(`${candidateRoot}/${name}/${index}.pko3`),`${name}: boundary ${i}`);}for(const key of ['result','models','experiments','approvals','questions','writes','cleanup','checks','observed'])assert.deepEqual(a.summary[key],b.summary[key],`${name}: ${key}`);rows.push({name,boundaries:a.recorded.length,controlImage:a.summary.imageSha256,candidateImage:b.summary.imageSha256,controlPeak:a.summary.peakWorkingBytes,candidatePeak:b.summary.peakWorkingBytes,controlCheckpoint:a.summary.maximumState,candidateCheckpoint:b.summary.maximumState});}\nwriteFileSync(output,JSON.stringify({scope:'Same prescribed source/tasks/replies; compare canonical payload/schema and nominal effect identity at every semantic boundary. Image/request envelope identities and private State bytes are deliberately separate.',kernelSha256:runtime.kernelSha256,rows},null,2)+'\\n');console.log(JSON.stringify({scenarios:rows.length,boundaries:rows.reduce((n,r)=>n+r.boundaries,0)}));\n"
  }
